# Postgres (Neon, Supabase…). Sem isso, o projeto usa um banco embutido em .data/ (só para desenvolvimento).
DATABASE_URL=

# Acesso ao /admin
ADMIN_PASSWORD=
SESSION_SECRET= # string longa e aleatória, ex.: openssl rand -base64 32

# WhatsApp Cloud API (Meta). Sem token/ID, os envios ficam em modo simulação.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=      # valida a assinatura do webhook
WHATSAPP_VERIFY_TOKEN=    # o mesmo texto cadastrado no painel da Meta ao configurar o webhook
WHATSAPP_TEMPLATE_LANG=pt_BR
# Nome dos templates aprovados, cada um com uma variável {{1}} no corpo
WHATSAPP_TEMPLATE_SABEDORIA=
WHATSAPP_TEMPLATE_EVENTO=
WHATSAPP_TEMPLATE_PEDIDO=
ADMIN_TEST_PHONE=         # seu WhatsApp, para o botão "Enviar teste para mim"

# Agendador (Vercel Cron envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Link do evento no lu.ma
NEXT_PUBLIC_LUMA_URL=https://lu.ma/bilhetes
NEXT_PUBLIC_SITE_URL=https://bilhetes.co
